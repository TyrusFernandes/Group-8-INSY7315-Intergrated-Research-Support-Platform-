@{
    var hideLayout = ViewData["HideLayoutElements"] as bool? ?? false;
}

<script src="https://www.gstatic.com/firebasejs/10.5.0/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.5.0/firebase-auth.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.5.0/firebase-firestore.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.5.0/firebase-storage.js"></script>

<script>
    const firebaseConfig = {
        apiKey: "YOUR_API_KEY",
        authDomain: "your-project.firebaseapp.com",
        projectId: "your-project-id",
        storageBucket: "your-project.appspot.com",
        messagingSenderId: "1234567890",
        appId: "1:1234567890:web:abcdef123456"
    };
    firebase.initializeApp(firebaseConfig);
</script>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcadenceWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcadenceWebApp.styles.css" asp-append-version="true" />

    <style>
        :root {
            --bg: #f2f6ff;
            --text: #1b1f3b;
            --card: #ffffff;
            --accent: #fc8e51;
            --primary: #5e72eb;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .wrapper {
            display: flex;
        }

        .sidebar {
            width: 60px;
            background-color: var(--text);
            transition: width 0.3s;
            height: 100vh;
            color: white;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            overflow-x: hidden;
            z-index: 999;
        }

        .sidebar-header {
            padding: 1rem;
            text-align: center;
        }

        .sidebar-logo {
            max-width: 100%;
            height: auto;
            transition: transform 0.3s ease;
        }

        .sidebar.collapsed .sidebar-logo {
            transform: scale(0.8);
        }

        .sidebar:hover {
            width: 200px;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            color: white;
            padding: 1rem;
            white-space: nowrap;
            text-decoration: none;
            transition: background 0.2s ease;
        }

            .sidebar .nav-link .icon {
                margin-right: 12px;
                font-size: 18px;
                min-width: 24px;
                text-align: center;
            }

        /* Initially hide the text label */
        .sidebar .link-text {
            opacity: 0;
            transition: opacity 0.2s ease;
            overflow: hidden;
        }

        /* On hover, show the text */
        .sidebar:hover .link-text {
            opacity: 1;
        }

            .sidebar .nav-link:hover {
                background-color: var(--primary);
            }

        .main {
            margin-left: 60px;
            transition: margin-left 0.3s;
            padding: 1rem;
            width: 100%;
        }

        .sidebar:hover ~ .main {
            margin-left: 200px;
        }

        .footer {
            text-align: center;
            margin-top: 2rem;
            padding: 1rem 0;
            color: #888;
        }
    </style>
</head>
<body>
    @if (!hideLayout)
    {
        <div class="wrapper">
            <div class="sidebar d-flex flex-column justify-content-between">
                <!-- Top section: logo + main nav -->
                <div>
                    <div class="sidebar-header">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/images/acadence-logo.png" alt="Acadence Logo" class="sidebar-logo" />
                        </a>
                    </div>

                    <div class="nav-section">

                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span class="icon">🏠</span>
                            <span class="link-text">Dashboard</span>
                        </a>

                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span class="icon">📋</span>
                            <span class="link-text">Tasks</span>
                        </a>

                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span class="icon">📁</span>
                            <span class="link-text">Documents</span>
                        </a>

                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span class="icon">💬</span>
                            <span class="link-text">Messages</span>
                        </a>

                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <span class="icon">📆</span>
                            <span class="link-text">Calendar</span>
                        </a>
                    </div>
                </div>

                <!-- Bottom section: pinned to bottom -->
                <div class="nav-section mb-4">

                    <a class="nav-link" asp-controller="Profile" asp-action="Index">
                        <span class="icon">👤</span>
                        <span class="link-text">Profile</span>
                    </a>

                    <a class="nav-link" asp-controller="Profile" asp-action="Index">
                        <span class="icon">⚙️</span>
                        <span class="link-text">Settings</span>
                    </a>

                    <a class="nav-link" asp-controller="Profile" asp-action="Index">
                        <span class="icon">❓</span>
                        <span class="link-text">Help Centre</span>
                    </a>
                </div>
            </div>



            <div class="main">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>


                
            </div>
        </div>
    }
    else
    {
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
