<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcadenceWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcadenceWebApp.styles.css" asp-append-version="true" />

    <style>
        :root {
            --bg: #f2f6ff;
            --text: #1b1f3b;
            --card: #ffffff;
            --accent: #fc8e51;
            --primary: #5e72eb;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .wrapper {
            display: flex;
        }

        .sidebar {
            width: 60px;
            background-color: var(--text);
            transition: width 0.3s;
            height: 100vh;
            color: white;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            overflow-x: hidden;
            z-index: 999;
        }

        .sidebar-header {
            padding: 1rem;
            text-align: center;
        }

        .sidebar-logo {
            max-width: 100%;
            height: auto;
            transition: transform 0.3s ease;
        }

        .sidebar.collapsed .sidebar-logo {
            transform: scale(0.8);
        }

        .sidebar:hover {
            width: 200px;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            color: white;
            padding: 1rem;
            white-space: nowrap;
            text-decoration: none;
            transition: background 0.2s ease;
        }

            .sidebar .nav-link .icon {
                margin-right: 12px;
                font-size: 18px;
                min-width: 24px;
                text-align: center;
            }

        .sidebar .link-text {
            opacity: 0;
            transition: opacity 0.2s ease;
            overflow: hidden;
        }

        .sidebar:hover .link-text {
            opacity: 1;
        }

        .sidebar .nav-link:hover {
            background-color: var(--primary);
        }

        .main {
            margin-left: 60px;
            transition: margin-left 0.3s;
            padding: 1rem;
            width: 100%;
        }

        .sidebar:hover ~ .main {
            margin-left: 200px;
        }

        .footer {
            text-align: center;
            margin-top: 2rem;
            padding: 1rem 0;
            color: #888;
        }
    </style>
</head>
<body>
    @if (!hideLayout)
    {
        <div class="wrapper">
            <div class="sidebar d-flex flex-column justify-content-between">
                <div>
                    <div class="sidebar-header">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/images/acadence-logo.png" alt="Acadence Logo" class="sidebar-logo" />
                        </a>
                    </div>

                    <div class="nav-section">
                        @if (userRole == "Admin")
                        {
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                <span class="icon">🏠</span><span class="link-text">Dashboard</span>
                            </a>
                            <a class="nav-link" asp-controller="Admin" asp-action="StudentSatisfaction">
                                <span class="icon">📊</span><span class="link-text">Student Satisfaction</span>
                            </a>

                            <!-- Fixed: point to AdminController.ConsultantWorkload -->
                            <a class="nav-link" asp-controller="Admin" asp-action="ConsultantWorkload">
                                <span class="icon">📈</span><span class="link-text">Consultant Workload</span>
                            </a>

                            <!-- Updated: points to AssignmentsController.Assign -->
                            <a class="nav-link" asp-controller="Assignments" asp-action="Assign">
                                <span class="icon">👥</span><span class="link-text">Assign Consultant</span>
                            </a>

                            <a class="nav-link" asp-controller="Admin" asp-action="Notifications">
                                <span class="icon">📢</span><span class="link-text">Broadcast Message</span>
                            </a>
                            <a class="nav-link" asp-controller="Admin" asp-action="UploadResource">
                                <span class="icon">📎</span><span class="link-text">Upload Resource</span>
                            </a>
                            <a class="nav-link" asp-controller="Admin" asp-action="EscalationManagement">
                                <span class="icon">🚨</span><span class="link-text">Escalation Console</span>
                            </a>
                            <a class="nav-link" asp-controller="Admin" asp-action="Feedback">
                                <span class="icon">📝</span><span class="link-text">Feedback</span>
                            </a>

                        }
                        else if (userRole == "consultant")
                        {
                            <a class="nav-link" asp-controller="Consultant" asp-action="Dashboard">
                                <span class="icon">🏠</span><span class="link-text">Dashboard</span>
                            </a>
                            <a class="nav-link" asp-controller="Consultant" asp-action="AssignedTasks">
                                <span class="icon">🗂️</span><span class="link-text">Assigned Tasks</span>
                            </a>
                            <a class="nav-link" asp-controller="Consultant" asp-action="ResourceLibrary">
                                <span class="icon">📚</span><span class="link-text">Resource Library</span>
                            </a>
                            <a class="nav-link" asp-controller="Consultant" asp-action="Messages">
                                <span class="icon">💬</span><span class="link-text">Messages</span>
                            </a>
                            <a class="nav-link" asp-controller="Consultant" asp-action="MeetingCalendar">
                                <span class="icon">🗓️</span><span class="link-text">Meeting Calendar</span>
                            </a>
                            <a class="nav-link" asp-controller="Consultant" asp-action="ProgressReport">
                                <span class="icon">📑</span><span class="link-text">Progress Reports</span>
                            </a>
                        }

                    </div>
                </div>

                <div class="nav-section mb-4">
                    <a class="nav-link" asp-controller="Profile" asp-action="Index">
                        <span class="icon">👤</span><span class="link-text">Profile</span>
                    </a>
                    <a class="nav-link" asp-controller="Settings" asp-action="Index">
                        <span class="icon">⚙️</span><span class="link-text">Settings</span>
                    </a>
                    <a class="nav-link" asp-controller="Help" asp-action="Index">
                        <span class="icon">❓</span><span class="link-text">Help Centre</span>
                    </a>
                </div>
            </div>

            <div class="main">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
