@model List<AcadenceWebApp.Models.RecentChatViewModel>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Messaging Home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultant Dashboard | Messages</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
        }

        #appContainer {
            display: flex;
            height: 100vh;
        }

        #chatList {
            width: 30%;
            background-color: #f9fafb;
            border-right: 1px solid #e5e7eb;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

            #chatList header {
                padding: 1rem;
                background-color: white;
                border-bottom: 1px solid #e5e7eb;
            }

            #chatList h1 {
                color: #1d4ed8;
                font-size: 1.25rem;
            }

            #chatList input {
                width: 100%;
                padding: 0.5rem;
                margin-top: 0.5rem;
                border-radius: 0.25rem;
                border: 1px solid #d1d5db;
            }

        #chatItemsContainer {
            flex-grow: 1;
            overflow-y: auto;
        }

        .chat-item {
            padding: 1rem;
            border-bottom: 1px solid #e5e7eb;
            cursor: pointer;
            transition: background-color 0.15s ease-in-out;
        }

            .chat-item:hover {
                background-color: #dbeafe;
            }

            .chat-item.selected {
                background-color: #bfdbfe;
            }

        #conversationArea {
            flex-grow: 1;
            padding: 2rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        #messagesContainer {
            flex-grow: 1;
            overflow-y: auto;
            margin-bottom: 1rem;
        }

        .msg-bubble {
            max-width: 60%;
            padding: 0.75rem;
            border-radius: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .msg-sent {
            background-color: #2563eb;
            color: white;
            align-self: flex-end;
        }

        .msg-received {
            background-color: white;
            border: 1px solid #e5e7eb;
            color: #374151;
            align-self: flex-start;
        }

        .msg-row {
            display: flex;
            margin-bottom: 0.5rem;
        }

        textarea {
            width: 100%;
            padding: 0.5rem;
            border-radius: 0.25rem;
            border: 1px solid #d1d5db;
            resize: none;
        }

        button {
            padding: 0.5rem 1rem;
            background-color: #2563eb;
            color: white;
            border: none;
            border-radius: 0.25rem;
            cursor: pointer;
            margin-top: 0.5rem;
        }

            button:hover {
                background-color: #1e40af;
            }

        #sendArea {
            margin-top: 1rem;
        }
    </style>
</head>
<body>
    <div id="appContainer">
        <!-- Left Panel -->
        <div id="chatList">
            <header>
                <h1>Messages</h1>
                <input type="text"
                       id="userSearch"
                       placeholder="Search or start new chat"
                       oninput="filterChats()"
                       onkeypress="checkEnter(event)">
            </header>

            <div id="chatItemsContainer">
                @if (Model == null || !Model.Any())
                {
                    <div style="padding: 1rem; color: #6b7280;">No recent chats.</div>
                }
                else
                {
                    foreach (var chat in Model)
                    {
                        <div class="chat-item" onclick="openChat('@chat.ChatRoomId', '@chat.OtherUserId', '@chat.OtherUsername')">
                            <span style="font-weight:600;">@chat.OtherUsername</span><br />
                            <span style="font-size:0.85rem; color:#6b7280;">@chat.LastMessage</span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Panel -->
        <div id="conversationArea">
            <div id="messagesContainer">
                <h2>Select or search for a user to start chatting</h2>
            </div>

            <div id="sendArea" style="display:none;">
                <textarea id="messageText" placeholder="Type your message..."></textarea>
                <button id="sendButton" onclick="sendMessage()">Send</button>
            </div>
        </div>
    </div>

    <script>
        let currentChatRoomId = null;
        let currentReceiverId = null;
        let currentReceiverName = null;

        // Filter chat list by username
        function filterChats() {
            const input = document.getElementById('userSearch').value.toLowerCase();
            const chats = document.querySelectorAll('.chat-item');
            chats.forEach(chat => {
                const username = chat.querySelector('span').innerText.toLowerCase();
                chat.style.display = username.includes(input) ? 'block' : 'none';
            });
        }

        // Press Enter to start new chat
        function checkEnter(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const username = document.getElementById('userSearch').value.trim();
                if (username) startNewChat(username);
            }
        }

        // Start new chat by resolving username to UID
        async function startNewChat(username) {
            try {
                const res = await fetch(`/Chat/GetUserIdByUsername?username=${encodeURIComponent(username)}`);
                if (!res.ok) {
                    alert("User not found");
                    return;
                }
                const data = await res.json();
                currentReceiverId = data.userId;
                currentReceiverName = username;
                currentChatRoomId = null;

                document.getElementById('messagesContainer').innerHTML = `<h2>New chat with ${username}</h2>`;
                document.getElementById('sendArea').style.display = 'block';
            } catch (err) {
                console.error("Error finding user:", err);
                alert("Error finding user.");
            }
        }

        // Open chat messages
        async function openChat(chatRoomId, otherUserId, otherUsername) {
            currentChatRoomId = chatRoomId;
            currentReceiverId = otherUserId;
            currentReceiverName = otherUsername;
            document.getElementById('sendArea').style.display = 'block';

            const container = document.getElementById('messagesContainer');
            container.innerHTML = `<h2>Chat with ${otherUsername}</h2><hr/>`;

            try {
                const res = await fetch(`/Chat/ChatRoom?chatRoomId=${chatRoomId}`);
                const messages = await res.json();

                container.innerHTML += messages.map(m => `
                    <div class="msg-row" style="justify-content:${m.senderId === currentReceiverId ? "flex-start" : "flex-end"};">
                        <div class="msg-bubble ${m.senderId === currentReceiverId ? "msg-received" : "msg-sent"}">
                            <div>${m.text}</div>
                            <div style="font-size:0.8rem;opacity:0.8;">${new Date(m.timestamp).toLocaleString()}</div>
                        </div>
                    </div>
                `).join('');

                container.scrollTop = container.scrollHeight;
            } catch (err) {
                console.error("Error loading messages:", err);
            }
        }

        // Send a message
        async function sendMessage() {
            const text = document.getElementById('messageText').value.trim();
            if (!text || !currentReceiverId) return;

            const payload = {
                receiverId: currentReceiverId,
                text: text
            };

            try {
                const res = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    document.getElementById('messageText').value = '';
                    const result = await res.json();
                    currentChatRoomId = result.chatRoomId;
                    openChat(currentChatRoomId, currentReceiverId, currentReceiverName);
                } else {
                    alert('Failed to send message.');
                }
            } catch (err) {
                console.error("Send message error:", err);
                alert("Error sending message.");
            }
        }
    </script>
</body>
</html>