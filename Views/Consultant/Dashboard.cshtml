@{
    ViewData["Title"] = "Consultant Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Prefer an explicit server-provided UID; fall back to session or claim if not set.
    var currentUserId = ViewBag.CurrentUserId
                        ?? Context.Session.GetString("UserUid")
                        ?? (User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "");
}
<!-- Notification Sidebar -->
<div id="notificationSidebar" style="position: fixed; top: 0; right: -400px; width: 400px; height: 100vh; background: white; box-shadow: -2px 0 10px rgba(0,0,0,0.2); overflow-y: auto; transition: right 0.3s; z-index: 1050; padding: 20px;">
    <h4>Notifications</h4>
    <div id="notificationsList">Loading...</div>
</div>

<!-- Overlay (click outside to close sidebar) -->
<div id="overlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.2); z-index:1040;"></div>

<!-- Main Page Content -->
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold" style="color: #5e72eb;">Welcome, Consultant!</h1>
        <p class="lead" style="color: #333;">Here's an overview of your current activities and tools available to assist your clients.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">🗂 Assigned Tasks</h5>
                    <p class="card-text">View and manage all your current client tasks and progress updates.</p>
                    <a href="/Consultant/AssignedTasks" class="btn btn-primary">Go to Tasks</a>
                </div>
            </div>
        </div>
        <!-- Add other cards here as needed -->
    </div>
</div>

<!-- Top Right Bell Button -->
<button id="notificationBtn" class="btn btn-light position-fixed" style="top: 20px; right: 30px; z-index: 1100;">
    🔔
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="unreadCount">0</span>
</button>

<!-- Centered Notification Modal -->
<div id="notificationModal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.6); z-index:2000; align-items:center; justify-content:center;">
    <div id="modalContent" style="background:white; padding:30px; border-radius:8px; max-width:500px; width:90%;">
        <h4 id="modalTitle"></h4>
        <p id="modalMessage"></p>
        <small id="modalTimestamp" class="text-muted"></small>
    </div>
</div>

<!-- Firebase Notification Logic -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.5.0/firebase-app.js";
    import {
        getFirestore, collection, getDocs, query, orderBy, updateDoc, doc, arrayUnion
    } from "https://www.gstatic.com/firebasejs/10.5.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyB8fUMWYN29wYg0YOvhW5NBUzstzpHD7pY",
      authDomain: "acadence-40662.firebaseapp.com",
      projectId: "acadence-40662",
      storageBucket: "acadence-40662.firebasestorage.app",
      messagingSenderId: "907171020913",
      appId: "1:907171020913:web:46cb92eea7b9ed0d28dbd0"
    };

    // Inject the server-determined current user id into the client script
    const CURRENT_USER_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUserId ?? ""));

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    const notificationBtn = document.getElementById("notificationBtn");
    const sidebar = document.getElementById("notificationSidebar");
    const overlay = document.getElementById("overlay");
    const notificationsList = document.getElementById("notificationsList");
    const unreadCount = document.getElementById("unreadCount");

    const modal = document.getElementById("notificationModal");
    const modalTitle = document.getElementById("modalTitle");
    const modalMessage = document.getElementById("modalMessage");
    const modalTimestamp = document.getElementById("modalTimestamp");

    let unread = 0;

    function toggleSidebar(show) {
        sidebar.style.right = show ? "0px" : "-400px";
        overlay.style.display = show ? "block" : "none";
    }

    notificationBtn && notificationBtn.addEventListener("click", () => toggleSidebar(true));
    overlay && overlay.addEventListener("click", () => toggleSidebar(false));

    modal && modal.addEventListener("click", (e) => {
        if (e.target === modal) {
            modal.style.display = "none";
        }
    });

    async function markAsRead(docId, alreadyRead) {
        if (!alreadyRead && CURRENT_USER_ID) {
            const notifRef = doc(db, "notifications", docId);
            // preserve array shape and append this UID only if not already present
            await updateDoc(notifRef, {
                readBy: arrayUnion(CURRENT_USER_ID)
            });
            unread = Math.max(0, unread - 1);
            unreadCount.innerText = unread > 0 ? unread : "0";
        }
    }

    async function loadNotifications() {
        const snapshot = await getDocs(query(collection(db, "notifications"), orderBy("priority", "desc")));
        unread = 0;
        notificationsList.innerHTML = "";

        snapshot.forEach(docSnap => {
            const data = docSnap.data();
            const recipients = data.recipientIds || [];
            const readBy = Array.isArray(data.readBy) ? data.readBy : [];

            // show if this notification targets the current user or is broadcast ("all")
            if ((CURRENT_USER_ID && recipients.includes(CURRENT_USER_ID)) || recipients.includes("all")) {
                const card = document.createElement("div");
                card.className = "card mb-2";
                card.style.cursor = "pointer";
                card.style.borderLeft = data.priority === "High" ? "5px solid red" : "5px solid gray";

                const body = document.createElement("div");
                body.className = "card-body";

                const date = data.timestamp?.toDate ? data.timestamp.toDate().toLocaleString() : "Unknown Date";

                body.innerHTML = `
                    <h5>${data.title || "Untitled"}</h5>
                    <p class="mb-1">${data.message || ""}</p>
                    <small class="text-muted">${date}</small>
                `;

                card.appendChild(body);

                // If unread, highlight it
                const isRead = readBy.includes(CURRENT_USER_ID);
                if (!isRead) {
                    card.style.background = "#fef8e7";
                    unread++;
                }

                // When clicked, show modal and mark as read
                card.addEventListener("click", async () => {
                    modalTitle.innerText = data.title || "Untitled";
                    modalMessage.innerText = data.message || "";
                    modalTimestamp.innerText = date;
                    modal.style.display = "flex";
                    await markAsRead(docSnap.id, isRead);
                });

                notificationsList.appendChild(card);
            }
        });

        unreadCount.innerText = unread;
    }

    loadNotifications();
</script>
