@model AcadenceWebApp.Models.ReviewWorkViewModel

@{
    ViewData["Title"] = "Review Work";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.DocTitle - Review</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f9fafb;
            margin: 0;
            padding: 2rem;
            color: #111827;
        }

        h2 {
            color: #1d4ed8;
            margin-bottom: 0.5rem;
        }

        a.download-btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background-color: #2563eb;
            color: white;
            border-radius: 0.25rem;
            text-decoration: none;
            margin: 1rem 0;
        }

            a.download-btn:hover {
                background-color: #1e40af;
            }

        form {
            margin-top: 2rem;
            max-width: 900px;
        }

        textarea, input[type="number"], input[type="file"] {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #d1d5db;
            border-radius: 0.25rem;
            resize: vertical;
            margin-top: 0.5rem;
            font-size: 1rem;
        }

        label {
            font-weight: 600;
            display: block;
            margin-top: 1rem;
        }

        button {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 0.25rem;
            cursor: pointer;
            margin-top: 1.5rem;
        }

            button:hover {
                background-color: #1e40af;
            }

        hr {
            margin: 2rem 0;
            border: none;
            border-top: 1px solid #e5e7eb;
        }
    </style>
</head>
<body>
    <h2>@Model.DocTitle</h2>
    <p>Click below to download and review the document:</p>
    <a href="@Model.FileUrl" target="_blank" class="download-btn">Download Document</a>

    <hr>

    <h3>Submit Review</h3>

    <div class="review-section">
        <h2>Consultant Review</h2>

        <form id="reviewForm">
            <div>
                <label>Rating (%):</label>
                <input type="number" id="ratingInput" name="rating" min="0" max="100" required>
            </div>

            <div>
                <label>Feedback:</label>
                <textarea id="feedbackInput" name="feedback" rows="4" placeholder="Write your feedback..."></textarea>
            </div>

            <div>
                <label>Upload File:</label>
                <input type="file" id="fileInput" name="file">
            </div>

            <button type="submit" class="submit-btn">Submit Review</button>
        </form>
    </div>
</body>
</html>

@section Scripts {
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
        import { getFirestore, doc, getDoc, collection, addDoc, query, where, getDocs } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
        import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-storage.js";

        // ✅ Firebase configuration
        const firebaseConfig = {
            apiKey: "AIzaSyB8fUMWYN29wYg0YOvhW5NBUzstzpHD7pY",
            authDomain: "acadence-40662.firebaseapp.com",
            projectId: "acadence-40662",
            storageBucket: "acadence-40662.firebasestorage.app",
            messagingSenderId: "907171020913",
            appId: "1:907171020913:web:46cb92ee7b9ed0d28dbd0"
        };

        // ✅ Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const storage = getStorage(app);

        // 🔹 Get the requestId from URL or Razor variable
        const urlParams = new URLSearchParams(window.location.search);
        const requestId = urlParams.get("requestId") || "@Model.RequestId"; // fallback from controller

        // 🔹 Get request info from Firestore
        async function getRequestDetails(requestId) {
            const docRef = doc(db, "requests", requestId);
            const docSnap = await getDoc(docRef);
            if (!docSnap.exists()) {
                alert("❌ Request not found!");
                return null;
            }
            return docSnap.data();
        }

        document.getElementById("reviewForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            const rating = parseFloat(document.getElementById("ratingInput").value);
            const feedback = document.getElementById("feedbackInput").value;
            const file = document.getElementById("fileInput").files[0];

            try {
                // ✅ Load request details from Firestore
                const requestData = await getRequestDetails(requestId);
                if (!requestData) return;

                const consultantId = requestData.assignedToUid;
                const consultantName = requestData.assignedToName;
                const userId = requestData.requestedByUid;
                const docTitle = requestData.docTitle;
                const reviewType = requestData.reviewType;

                // ✅ Find current review count to assign version
                const q = query(collection(db, "reviews"), where("requestId", "==", requestId));
                const querySnapshot = await getDocs(q);
                const version = querySnapshot.size + 1;

                let fileUrl = "";
                if (file) {
                    const storageRef = ref(storage, `reviews/${requestId}/v${version}_${file.name}`);
                    await uploadBytes(storageRef, file);
                    fileUrl = await getDownloadURL(storageRef);
                }

                // ✅ Save review
                await addDoc(collection(db, "reviews"), {
                    requestId,
                    consultantId,
                    consultantName,
                    userId,
                    docTitle,
                    reviewType,
                    rating,
                    feedback,
                    fileUrl,
                    version,
                    timestamp: new Date()
                });

                alert(`✅ Review submitted successfully! (Version ${version})`);
                document.getElementById("reviewForm").reset();

            } catch (error) {
                console.error("Error submitting review:", error);
                alert("❌ Error submitting review. Check console.");
            }
        });
    </script>
}