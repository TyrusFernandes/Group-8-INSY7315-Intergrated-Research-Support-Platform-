@model AcadenceWebApp.Models.EscalationItemDto
@{
    ViewData["Title"] = "Escalation Details";
}
<div class="container py-4" style="max-width: 640px;">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-3" style="font-weight:700; color:#2b2d42;">
                <span class="me-2">⚠️</span> @Model.StudentName — @Model.Issue
            </h4>

            <dl class="row">
                <dt class="col-sm-3">Severity</dt>
                <dd class="col-sm-9">@Model.Severity</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>

            <a class="btn btn-outline-secondary" asp-action="EscalationManagement">Back</a>
        </div>
    </div>
</div>
