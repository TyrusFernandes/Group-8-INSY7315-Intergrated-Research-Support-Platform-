@model AcadenceWebApp.Models.ConsultantWorkloadViewModel

@{
    ViewData["Title"] = "Consultant Workload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Consultant Workload</h1>

<!-- Point form to Admin controller so admin link & actions stay consistent -->
<form method="get" asp-controller="Admin" asp-action="ConsultantWorkload" class="mb-3">
    <div style="display:flex; gap:8px; max-width:720px;">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search consultant name or email..."
               style="flex:1; padding:8px; border:1px solid #ccc; border-radius:4px;" />
        <button type="submit" style="padding:8px 14px; background:#0047ff; color:white; border:none; border-radius:4px;">Search</button>
        <a href="@Url.Action("ConsultantWorkload", "Admin")" style="padding:8px 14px; background:#6c757d; color:white; border-radius:4px; text-decoration:none;">Clear</a>
    </div>
</form>

@if (!Model.Consultants.Any())
{
    <div class="alert alert-info">No consultants found.</div>
}
else
{
    <div style="display:grid; gap:16px;">
        @foreach (var c in Model.Consultants)
        {
            <div style="padding:12px; border:1px solid #e3e3e3; border-radius:6px; background:white;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <strong>@c.ConsultantName</strong><br />
                        <small>@c.Email</small>
                    </div>
                    <div>
                        <small>@(c.StudentRequests?.Count ?? 0) requests</small>
                    </div>
                </div>

                <div style="margin-top:10px;">
                    @if (c.StudentRequests == null || !c.StudentRequests.Any())
                    {
                        <div style="color:#666;">No assigned requests.</div>
                    }
                    else
                    {
                        <table class="table table-sm" style="margin-top:6px;">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Request</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in c.StudentRequests.OrderByDescending(x => x.RequestDate).Take(20))
                                {
                                    <tr>
                                        <td>@r.StudentName</td>
                                        <td>@r.RequestTitle</td>
                                        <td>@r.Status</td>
                                        <td>@(r.RequestDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    </div>
}
