@model AcadenceWebApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var chartData = System.Text.Json.JsonSerializer.Serialize(new
    {
        satisfied = Model?.Satisfied ?? 0,
        neutral = Model?.Neutral ?? 0,
        unsatisfied = Model?.Unsatisfied ?? 0,
        average = Model?.AverageRating ?? 0,
        total = Model?.TotalFeedbackCount ?? 0
    });
}

<style>
    /* ===== Admin Dashboard – Figma-style theme (Option B) ===== */

    .admin-wrapper {
        padding: 32px 40px;
        background-color: #f3f4f7;
        min-height: 100vh;
    }

    .admin-title {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 4px;
    }

    .admin-subtitle {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 24px;
    }

    /* Stat cards grid */
    .admin-stats-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 18px;
        margin-bottom: 32px;
    }

    .admin-stat-card {
        border-radius: 18px;
        padding: 20px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15,23,42,0.06);
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
        text-decoration: none;
        color: inherit;
    }

        .admin-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(15,23,42,0.12);
        }

    .stat-gradient-blue {
        background: linear-gradient(135deg, #1d4ed8, #60a5fa);
        color: white;
    }

    .stat-gradient-green {
        background: linear-gradient(135deg, #059669, #34d399);
        color: white;
    }

    .stat-gradient-yellow {
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: #111;
    }

    .stat-gradient-slate {
        background: linear-gradient(135deg, #64748b, #94a3b8);
        color: white;
    }

    .stat-label {
        font-size: 13px;
        opacity: .9;
        font-weight: 500;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
        margin-top: 6px;
    }

    .stat-extra {
        font-size: 12px;
        opacity: .85;
        margin-top: 4px;
    }

    /* Main body layout */
    .admin-main {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    .admin-panel {
        background: white;
        padding: 20px;
        border-radius: 18px;
        box-shadow: 0 6px 18px rgba(15,23,42,0.05);
    }

    .panel-title {
        font-size: 16px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 16px;
    }

    /* Feedback table */
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .admin-table th {
            text-transform: uppercase;
            font-size: 12px;
            color: #6b7280;
            letter-spacing: .05em;
            padding-bottom: 10px;
        }

        .admin-table td {
            padding: 12px 6px;
            border-bottom: 1px solid #e5e7eb;
            color: #374151;
        }

    /* Recent resources list */
    .resource-item {
        padding: 10px 12px;
        border-bottom: 1px solid #e5e7eb;
    }

        .resource-item:last-child {
            border-bottom: none;
        }

        .resource-item a {
            font-weight: 600;
            color: #1d4ed8;
            text-decoration: none;
        }

            .resource-item a:hover {
                text-decoration: underline;
            }

    .resource-meta {
        font-size: 12px;
        color: #6b7280;
        margin-top: 2px;
    }
</style>

<div class="admin-wrapper">

    <div class="admin-title">Admin Dashboard</div>
    <div class="admin-subtitle">Overview of resources, feedback & system activity.</div>

    <!-- ===== TOP STATS ===== -->
    <div class="admin-stats-row">

        <!-- Resources -->
        <a href="@Url.Action("UploadResource", "Admin")" class="admin-stat-card stat-gradient-blue">
            <div class="stat-label">Resources</div>
            <div class="stat-value">@Model.ResourcesCount</div>
        </a>

        <!-- Feedback -->
        <a href="@Url.Action("StudentSatisfaction", "Admin")" class="admin-stat-card stat-gradient-slate">
            <div class="stat-label">Feedback Count</div>
            <div class="stat-value">@Model.TotalFeedbackCount</div>
            <div class="stat-extra">Avg: @Model.AverageRating.ToString("0.0")</div>
        </a>

        <!-- Support Tickets -->
        <a href="@Url.Action("EscalationManagement", "Admin")" class="admin-stat-card stat-gradient-yellow">
            <div class="stat-label">Support Tickets</div>
            <div class="stat-value">@Model.SupportTicketsCount</div>
        </a>

        <!-- Assignments -->
        <a href="@Url.Action("Assign", "Assignments")" class="admin-stat-card stat-gradient-green">
            <div class="stat-label">Pending Assignments</div>
            <div class="stat-value">@Model.AssignRequestsCount</div>
        </a>
    </div>

    <!-- ===== MAIN ===== -->
    <div class="admin-main">

        <!-- LEFT: Feedback + Resources -->
        <div>
            <div class="admin-panel">
                <div class="panel-title">Recent Feedback</div>

                @if (Model.RecentFeedbacks != null && Model.RecentFeedbacks.Any())
                {
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>From</th>
                                <th>Consultant</th>
                                <th>Rating</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.RecentFeedbacks)
                            {
                                <tr>
                                    <td>@f.Timestamp.ToLocalTime().ToString("g")</td>
                                    <td>@(f.StudentName ?? f.StudentUid)</td>
                                    <td>@(f.ConsultantName ?? f.ConsultantUid)</td>
                                    <td>@f.Rating</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-muted" style="font-size:13px;">No feedback yet.</div>
                }
            </div>

            <div class="admin-panel" style="margin-top:20px;">
                <div class="panel-title">Recent Resources</div>

                @if (Model.RecentResources.Any())
                {
                    @foreach (var r in Model.RecentResources)
                    {
                        <div class="resource-item">
                            <a href="@r.Url" target="_blank">@r.Title</a>
                            <div class="resource-meta">@r.OriginalName — @r.UploadedAt.ToLocalTime().ToString("g")</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted" style="font-size:13px;">No resources uploaded.</div>
                }
            </div>
        </div>

        <!-- RIGHT: Satisfaction Chart -->
        <div>
            <div class="admin-panel">
                <div class="panel-title">Satisfaction Breakdown</div>

                <div style="max-width:360px; margin:0 auto;">
                    <canvas id="dashboardChart" height="220"></canvas>
                </div>

                <div class="mt-3 text-center small text-muted">
                    Avg rating: @Model.AverageRating.ToString("0.0")
                    — Total feedbacks: @Model.TotalFeedbackCount
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function(){
            const stats = @Html.Raw(chartData);
            const ctx = document.getElementById('dashboardChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Satisfied', 'Neutral', 'Unsatisfied'],
                    datasets: [{
                        data: [stats.satisfied, stats.neutral, stats.unsatisfied],
                        backgroundColor: ['#0ea5e9', '#fbbf24', '#ef4444']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position:'bottom' }
                    }
                }
            });
        })();
    </script>
}
