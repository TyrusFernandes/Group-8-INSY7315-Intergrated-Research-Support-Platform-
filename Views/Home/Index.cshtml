@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideLayoutElements"] = true;
}

<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center bg-light">
    <div class="text-center w-100" style="max-width: 600px;">
        <img src="/images/acadence-logo.png" alt="Acadence Logo" class="img-fluid mb-4" style="max-height: 200px;" />
        <h2 class="mb-4 display-5">Welcome!</h2>

        <div class="d-grid gap-4">
            <a class="btn btn-primary btn-lg rounded-pill py-3" href="/Home/Register">Sign Up</a>
            <a class="btn btn-primary btn-lg rounded-pill py-3" href="/Home/Login">Log In</a>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f6f4f1;
        margin: 0;
        padding: 0;
    }

    h2 {
        color: #333;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .btn-primary {
        background-color: #0047ff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0036cc;
        }
</style>