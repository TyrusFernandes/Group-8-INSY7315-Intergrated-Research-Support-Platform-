@model AcadenceWebApp.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acadence - Login</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #e8e8e8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            display: flex;
            width: 100%;
            max-width: 1400px;
            gap: 100px;
            align-items: center;
        }

        .left-section {
            flex: 1;
            max-width: 600px;
        }

        .right-section {
            flex: 1;
            text-align: center;
        }

        h1 {
            color: #999;
            font-size: 48px;
            font-weight: 400;
            margin-bottom: 80px;
            letter-spacing: 1px;
        }

        .form-group {
            margin-bottom: 40px;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 20px 25px;
            font-size: 18px;
            border: 3px solid #999;
            border-radius: 12px;
            background-color: #e8e8e8;
            color: #666;
            font-weight: 400;
            outline: none;
            transition: border-color 0.3s;
        }

            input[type="email"]:focus,
            input[type="password"]:focus {
                border-color: #0052ff;
            }

        input::placeholder {
            color: #999;
            font-weight: 400;
        }

        .forgot-password {
            text-align: right;
            margin-top: 15px;
        }

            .forgot-password a {
                color: #0052ff;
                text-decoration: none;
                font-size: 16px;
                font-weight: 400;
            }

                .forgot-password a:hover {
                    text-decoration: underline;
                }

        .login-btn {
            width: 100%;
            padding: 20px;
            background-color: #0052ff;
            color: white;
            font-size: 20px;
            font-weight: 500;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            margin-top: 30px;
            transition: background-color 0.3s;
        }

            .login-btn:hover {
                background-color: #0041cc;
            }

        .signup-link {
            text-align: center;
            margin-top: 30px;
            color: #999;
            font-size: 16px;
        }

            .signup-link a {
                color: #0052ff;
                text-decoration: none;
                font-weight: 500;
            }

                .signup-link a:hover {
                    text-decoration: underline;
                }

        .logo-section {
            position: relative;
        }

        .graduation-cap {
            width: 200px;
            height: 140px;
            margin-bottom: -40px;
            margin-left: auto;
            margin-right: auto;
            position: relative;
            z-index: 2;
        }

        .cap-top {
            width: 100%;
            height: 20px;
            background-color: #000;
            border-radius: 0;
            transform: perspective(200px) rotateX(20deg);
        }

        .cap-board {
            width: 240px;
            height: 12px;
            background-color: #000;
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%) perspective(200px) rotateX(20deg);
        }

        .tassel {
            width: 6px;
            height: 40px;
            background-color: #ffd700;
            position: absolute;
            top: 0;
            right: 30px;
            border-radius: 3px;
        }

            .tassel::after {
                content: '';
                width: 12px;
                height: 12px;
                background-color: #ffd700;
                border-radius: 50%;
                position: absolute;
                top: -6px;
                left: -3px;
            }

        .logo-a {
            font-size: 180px;
            font-weight: bold;
            color: #0052ff;
            line-height: 1;
            margin-bottom: 10px;
        }

        .logo-text {
            font-size: 72px;
            font-weight: 400;
            color: #0052ff;
            letter-spacing: 8px;
            margin-bottom: 20px;
        }

        .tagline {
            font-size: 28px;
            color: #999;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .error-message {
            color: #dc3545;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 16px;
        }

        .field-validation-error {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            color: #dc3545;
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 16px;
        }

            .validation-summary-errors ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }

        @@media (max-width: 1024px) {
            .container

        {
            flex-direction: column;
            gap: 60px;
        }

        .right-section {
            order: -1;
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-section">
            <h1>Welcome Back!</h1>

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <form asp-action="Login" asp-controller="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <input asp-for="Email" type="email" placeholder="email" required />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <input asp-for="Password" type="password" placeholder="password" required />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                    <div class="forgot-password">
                        <a asp-action="ForgotPassword" asp-controller="Login">Forgot your Password?</a>
                    </div>
                </div>

                <button type="submit" class="login-btn">Log In</button>

                <div class="signup-link">
                    Don't have an account? <a asp-action="Register" asp-controller="Login">Sign Up</a>
                </div>
            </form>
        </div>

        <div class="right-section">
            <div class="logo-section">
                <img src="~/images/acadence-logo.png" alt="Acadence Logo" class="img-fluid mb-4" style="max-height: 400px;" />
                <div class="tagline">Where Excellence Meets Guidance</div>
            </div>
        </div>
    </div>

    @if (Context.Request.Path.Value.Contains("Login"))
    {
        <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    }
</body>
</html>
