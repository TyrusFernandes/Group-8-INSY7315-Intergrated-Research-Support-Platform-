@model AcadenceWebApp.Models.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Forgot Password</title>
    <meta name="viewport" content="width=device-width" />
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background:#f4f6f8; display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; }
        .card { background:white; padding:28px; border-radius:12px; box-shadow:0 6px 24px rgba(0,0,0,0.08); width:380px; max-width:95%; }
        h2 { margin:0 0 12px; color:#333; font-weight:600; }
        p { color:#666; margin:0 0 18px; font-size:14px; }
        input[type="email"] { width:100%; padding:12px 14px; border-radius:8px; border:1px solid #dcdfe6; margin-bottom:12px; font-size:14px; }
        .btn { width:100%; padding:12px; border-radius:8px; background:#0052ff; color:white; border:none; font-weight:600; cursor:pointer; }
        .links { margin-top:12px; text-align:center; font-size:13px; }
        .message { background:#e8f6ff; color:#0456a6; padding:10px 12px; border-radius:8px; margin-bottom:12px; font-size:14px; }
        .field-validation-error { color: #dc3545; font-size:13px; margin-bottom:8px; display:block; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Reset your password</h2>
        <p>Enter the email address for your account. We'll send a link to reset your password.</p>

        @if (ViewBag.Message != null)
        {
            <div class="message">@ViewBag.Message</div>
        }

        <form asp-action="ForgotPassword" asp-controller="Login" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="email" placeholder="you@example.com" />
            <span asp-validation-for="Email" class="field-validation-error"></span>

            <button type="submit" class="btn">Send reset link</button>
        </form>

        <div class="links">
            <a asp-action="Login" asp-controller="Login">Return to login</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>