@model AcadenceWebApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ✅ Link to Updated CSS -->
<link rel="stylesheet" href="~/css/register.css" />

<div class="reg-page">
    <div class="reg-card">
        <!-- LEFT SIDE (form) -->
        <div class="reg-left">
            <div class="social-row">
                <button id="firebase-google-btn" class="btn-social google">
                    <img src="@Url.Content("~/images/google-icon.png")" alt="Google" class="social-icon" />
                    Sign up with Google
                </button>
            </div>

            <div class="or-divider"><span>OR</span></div>

            <h3 class="reg-heading">Please enter your details</h3>

            <form asp-action="Register" asp-controller="Login" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="input-wrap">
                    <input asp-for="Email" class="input-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="input-wrap">
                    <input asp-for="Username" class="input-control" placeholder="Username" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="input-wrap">
                    <input asp-for="Password" type="password" class="input-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="input-wrap">
                    <input asp-for="ConfirmPassword" type="password" class="input-control" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <div class="cta-wrap">
                    <button type="submit" class="btn-primary-large">Sign Up</button>
                </div>
            </form>

            <div class="have-account">
                Already have an account?
                <a asp-action="Login" asp-controller="Login" class="login-link">Log in</a>
            </div>
        </div>

        <!-- RIGHT SIDE (logo and tagline) -->
        <div class="reg-right">
            <div class="logo-holder">
                <!-- ✅ Fixed image path -->
                <img src="@Url.Content("~/images/acadence-logo.png")" alt="Acadence Logo" class="brand-logo" />
            </div>
            <p class="brand-tag">Where Excellence Meets Guidance</p>
        </div>
    </div>
</div>

<!-- ✅ Firebase -->
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>

<script>
    const firebaseConfig = {
        apiKey: "YOUR_API_KEY",
        authDomain: "YOUR_AUTH_DOMAIN",
        projectId: "YOUR_PROJECT_ID",
        storageBucket: "YOUR_STORAGE_BUCKET",
        messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
        appId: "YOUR_APP_ID"
    };

    firebase.initializeApp(firebaseConfig);

    const googleBtn = document.getElementById("firebase-google-btn");
    googleBtn?.addEventListener("click", function () {
        const provider = new firebase.auth.GoogleAuthProvider();
        firebase.auth().signInWithPopup(provider)
            .then(result => {
                console.log("Google Sign-In Success:", result.user);
            })
            .catch(error => {
                console.error("Google Sign-In Error:", error);
            });
    });
</script>
