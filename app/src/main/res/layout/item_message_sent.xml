<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <!-- Message Bubble (Aligned Right) -->
    <TextView
        android:id="@+id/textMessageBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chat_bubble_sent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:maxWidth="300dp"
        android:text="This is a message sent by the user."
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Timestamp (Optional - often below or next to the bubble) -->
    <TextView
        android:id="@+id/textMessageTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:30 AM"
        android:textSize="10sp"
        android:textColor="#888888"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/textMessageBody"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
